NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E2E (Playwright). Optional when SUPABASE_SERVICE_ROLE_KEY is set:
# the test user is created/confirmed automatically.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Payments (Stripe, test mode). Use sk_test_... / whsec_... keys for the
# test environment. PAYMENT_CURRENCY is the currency for plan prices
# (Pro 99, Business 299); defaults to usd.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd

